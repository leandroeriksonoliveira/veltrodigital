{
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/contabilidade",
      "destination": "https://veltro-contabilidade.vercel.app/"
    },
    {
      "source": "/contabilidade/",
      "destination": "https://veltro-contabilidade.vercel.app/"
    },
    {
      "source": "/contabilidade/:path*",
      "destination": "https://veltro-contabilidade.vercel.app/:path*"
    }
  ]
}
